{
  "name": "simulador-electromagnetismo",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "electron": "electron electron/main.cjs",
    "electron:start": "npm run build && electron electron/main.cjs",
    "electron:dev": "concurrently -k -s first \"cross-env ELECTRON_DEV=1 vite\" \"wait-on tcp:5173 && cross-env ELECTRON_DEV=1 electron electron/main.cjs\"",
    "electron:pack": "npm run build && electron-builder --dir",
    "electron:exe": "npm run build && electron-builder --win portable",
    "electron:nsis": "npm run build && electron-builder --win nsis"
  },
  "build": {
    "appId": "edu.unicesar.simuladorelectromagnetismo",
    "productName": "Simulador Electromagnetismo UPC",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Simulador Electromagnetismo UPC"
    },
    "portable": {
      "artifactName": "Simulador_Electromagnetismo_UPC_Portable.exe"
    },
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "onlyLoadAppFromAsar": true
    }
  },
  "dependencies": {
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "oxlint": "^1.93.0",
    "tailwindcss": "^4.2.2",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.1",
    "wait-on": "^9.5.1"
  },
  "description": "Simulador de Electromagnetismo — Laboratorio Virtual de la Universidad Popular del Cesar (UPC)"
}
